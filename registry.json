{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "brut",
  "homepage": "https://github.com/akhil1o1/brutalism-ui",
  "items": [
    {
      "name": "base",
      "type": "registry:base",
      "title": "BRUT/UI Base",
      "description": "Project-wide neo-brutalist tokens, palettes, strength levels, radii, focus states, and interaction utilities.",
      "config": {
        "style": "base-nova",
        "iconLibrary": "lucide",
        "rsc": true,
        "tsx": true,
        "tailwind": {
          "baseColor": "neutral"
        }
      },
      "dependencies": ["tw-animate-css"],
      "files": [
        {
          "path": "registry/brutalist/styles/brutalist.css",
          "type": "registry:file",
          "target": "@components/styles/brutalist.css"
        }
      ],
      "docs": "Set data-brut-palette (paper, signal, or sky), data-brut-strength (soft, solid, or loud), and data-brut-radius (sharp, cut, or chunky) on the html element. Components import this project-wide stylesheet automatically."
    },
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "A tactile neo-brutalist button with the standard shadcn API.",
      "dependencies": ["@base-ui/react", "class-variance-authority"],
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "registry/brutalist/ui/button.tsx",
          "type": "registry:ui",
          "target": "@ui/button.tsx"
        },
        {
          "path": "registry/brutalist/styles/brutalist.css",
          "type": "registry:file",
          "target": "@components/styles/brutalist.css"
        }
      ]
    },
