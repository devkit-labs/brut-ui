{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "brut-ui",
  "homepage": "https://www.brut-ui.site/",
  "items": [
    {
      "name": "base",
      "type": "registry:base",
      "title": "BRUT/UI Base",
      "description": "Project-wide neo-brutalist tokens, flavours, strength levels, radii, focus states, and interaction utilities.",
      "config": {
        "style": "base-nova",
        "iconLibrary": "lucide",
        "rsc": true,
        "tsx": true,
        "tailwind": {
          "baseColor": "neutral"
        }
      },
      "dependencies": [
        "tw-animate-css"
      ],
      "files": [
        {
          "path": "registry/brutalist/styles/brutalist.css",
          "type": "registry:file",
          "target": "@components/styles/brutalist.css"
        }
      ],
      "docs": "Choose the Paper, Signal, or Sky flavour with data-brut-palette; set data-brut-strength to soft, solid, or loud; and set data-brut-radius to sharp, cut, or chunky on the html element. Components import this project-wide stylesheet automatically."
    },
